# ---------------------------------------------------------------------------
# deploy/.env.images — WHICH IMAGE IS RUNNING RIGHT NOW.
#
# Machine managed: deploy/scripts/deploy.sh rewrites these lines on every
# rollout and keeps the previous copy in .env.images.previous for rollback.
# Edit by hand only when recovering from a broken deploy.
#
# `latest` is a placeholder for the very first bootstrap. After that these are
# always immutable tags — a release version (1.4.0) or sha-<full commit sha>.
# ---------------------------------------------------------------------------

API_IMAGE_TAG=latest
DASHBOARD_IMAGE_TAG=latest
TENANT_WEB_IMAGE_TAG=latest
LANDING_IMAGE_TAG=latest
