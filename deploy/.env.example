# ---------------------------------------------------------------------------
# deploy/.env — host level wiring for the compose stack.
#
#   cp .env.example .env
#
# Only infrastructure lives here: registry, ports, timezone. Application
# configuration and every secret live in deploy/env/<app>.env.
# Image tags live in deploy/.env.images and are written by deploy.sh.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=sewantara

# GHCR namespace. Must be lowercase and must match the GitHub owner that runs
# the workflows, e.g. ghcr.io/sewantara
REGISTRY=ghcr.io/sewantara

TZ=Asia/Jakarta

# ---------------------------------------------------------------------------
# Host ports. Everything is published on the loopback-or-LAN side and fronted
# by Nginx Proxy Manager / a load balancer that terminates TLS.
#
#   api.sewantara.id      -> API_HTTP_PORT
#   app.sewantara.id      -> DASHBOARD_PORT
#   *.sewantara.id        -> TENANT_WEB_PORT
#   sewantara.id          -> LANDING_PORT
#
# Change the host port freely; container ports never move.
# ---------------------------------------------------------------------------

API_HTTP_BIND=0.0.0.0
API_HTTP_PORT=8090

DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=3005

TENANT_WEB_BIND=0.0.0.0
TENANT_WEB_PORT=3000

LANDING_BIND=0.0.0.0
LANDING_PORT=3003

# ---------------------------------------------------------------------------
# PostgreSQL exposure. 127.0.0.1 means "SSH tunnel only", which is the right
# default. If you must reach it from pgAdmin, set 0.0.0.0 AND restrict the
# port in the firewall to the admin IP — see docs/06_RUNBOOK.md.
# ---------------------------------------------------------------------------

POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PUBLIC_PORT=5432

# Redis is queue + cache + Reverb state with maxmemory-policy=noeviction.
# Size it above the working set: on OOM, jobs fail loudly instead of vanishing.
REDIS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# Rollout behaviour (read by deploy/scripts/deploy.sh)
# ---------------------------------------------------------------------------

# Seconds to wait for every touched service to report healthy before the
# deploy is declared failed and rolled back.
HEALTH_TIMEOUT=180

# Set to 0 to keep a failed rollout in place for debugging instead of
# restoring the previous image tags automatically.
AUTO_ROLLBACK=1
