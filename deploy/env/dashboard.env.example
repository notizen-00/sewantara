# ---------------------------------------------------------------------------
# deploy/env/dashboard.env — apps/dashboard (Nuxt SPA, ssr:false)
#
# HEADS UP: the dashboard is a client-only SPA, so NUXT_PUBLIC_* is compiled
# into the JavaScript bundle at BUILD time. Setting it here is a safety net,
# not the source of truth. The real value comes from the GitHub Actions
# repository variable NUXT_PUBLIC_API_BASE, which is passed as a build arg.
# Changing it requires a rebuild, not a restart.
# See docs/02_DOCKER_IMAGES.md and docs/adr/0004-dashboard-config-build-time.md
# ---------------------------------------------------------------------------

# Must be reachable from the end user's browser, not from inside Docker.
NUXT_PUBLIC_API_BASE=https://api.sewantara.id

# Base domain used to build tenant links in the operator UI.
NUXT_PUBLIC_TENANT_BASE_DOMAIN=sewantara.id
