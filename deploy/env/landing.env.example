# ---------------------------------------------------------------------------
# deploy/env/landing.env — apps/landing (Nuxt SSR, sewantara.id)
#
# Intentionally almost empty. The landing site has no backend dependency, no
# secrets, and apps/landing/nuxt.config.ts declares no runtimeConfig — so there
# is nothing to configure yet.
#
# The file exists so that every app in the stack has the same shape, and so
# adding a value later is an edit here rather than a change to compose.yml.
#
# NODE_ENV, HOST and PORT are set by compose.yml, not here.
# ---------------------------------------------------------------------------

TZ=Asia/Jakarta
