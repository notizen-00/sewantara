# ---------------------------------------------------------------------------
# deploy/env/tenant-web.env — apps/tenant-web (Nuxt SSR, *.sewantara.id)
#
# SSR app: every value here is read at container start, so a change is a
# restart, not a rebuild.
#
# NOTE ON NAMES: Nuxt overrides nested runtimeConfig keys by flattening them
# with underscores. `runtimeConfig.apiEndpoints.tenant` is therefore
# NUXT_API_ENDPOINTS_TENANT here — not the NUXT_API_TENANT_ENDPOINT name used
# by apps/tenant-web/.env.example, which only applies to the build-time
# defaults in nuxt.config.ts.
# ---------------------------------------------------------------------------

NUXT_PUBLIC_APP_NAME=Sewantara
NUXT_PUBLIC_BASE_URL=https://sewantara.id
NUXT_PUBLIC_BASE_DOMAIN=sewantara.id
NUXT_PUBLIC_CDN=

# The browser only ever talks to this app's own /api (BFF). Server side, Nitro
# calls the Laravel API with this base URL.
#
# Keep the public URL: Laravel resolves the tenant from the Host header, so
# short-circuiting to http://api-web over the docker network would need the
# forwarded Host preserved. Only switch after verifying tenant resolution.
NUXT_API_BASE=https://api.sewantara.id
NUXT_API_TOKEN=

NUXT_API_ENDPOINTS_TENANT=/v1/public/tenant
NUXT_API_ENDPOINTS_HOME=/v1/public/home
NUXT_API_ENDPOINTS_CATALOG=/v1/public/catalog
NUXT_API_ENDPOINTS_QUOTE=/v1/public/bookings/quote
NUXT_API_ENDPOINTS_BOOKINGS=/v1/public/bookings
NUXT_API_ENDPOINTS_TRACKING=/v1/public/bookings
NUXT_API_ENDPOINTS_BLOG=/v1/public/blog

# Turn demo mode off once the Laravel public API is live for real tenants.
NUXT_PUBLIC_DEMO_MODE=false
NUXT_PUBLIC_DEMO_TENANT=kamerajember

# Only enable when Nitro sits behind a proxy that always overwrites the
# forwarded headers, otherwise a client can spoof the tenant.
NUXT_TRUST_PROXY=true
NUXT_ALLOW_CUSTOM_DOMAINS=false
NUXT_ROOT_TENANT=
