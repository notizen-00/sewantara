# ---------------------------------------------------------------------------
# apps/api/.env.development.example — Docker development stack.
#
#   cp .env.development.example .env.development
#   docker compose --env-file .env.development up -d --build
#
# This is the single-app dev stack in apps/api/compose.yaml (project name
# sewantara-api-dev), NOT the production stack in deploy/. Values point at
# in-cluster service names (postgres, redis) rather than 127.0.0.1.
#
# NOTE: this file was reconstructed on 2026-08-07 (see docs/07_SECRETS_AND_ENV.md).
# Every variable the application and compose.yaml read is present, but compare
# against your own working .env.development before relying on it.
# ---------------------------------------------------------------------------

APP_NAME=Sewantara
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
APP_BIND_IP=0.0.0.0
APP_HTTP_PORT=8090
APP_IMAGE_TAG=dev
APP_ENV_FILE=.env.development

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=10

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sewantara_app
DB_USERNAME=sewantara
DB_PASSWORD=sewantara
DB_SSLMODE=prefer

POSTGRES_DB=sewantara_app
POSTGRES_USER=sewantara
POSTGRES_PASSWORD=sewantara
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PUBLIC_PORT=5432

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sewantara
REVERB_APP_KEY=dev-reverb-key
REVERB_APP_SECRET=dev-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_ALLOWED_ORIGINS=*

REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8090
REVERB_PUBLIC_SCHEME=http
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_PUBLIC_HOST}
VITE_REVERB_PORT=${REVERB_PUBLIC_PORT}
VITE_REVERB_SCHEME=${REVERB_PUBLIC_SCHEME}
VITE_APP_NAME=${APP_NAME}

TENANT_BASE_DOMAIN=sewantara.test
CENTRAL_DOMAINS=localhost,api.sewantara.test
CENTRAL_DOMAIN=sewantara.test
API_DOMAIN=api.sewantara.test
TENANT_PUBLIC_WEB_ENABLED=true
TENANT_DEFAULT_TIMEZONE=Asia/Jakarta
TENANT_DEFAULT_LOCALE=id-ID
TENANT_DEFAULT_CURRENCY=IDR
BFF_SERVICE_TOKEN_CURRENT=dev-bff-token
BFF_SERVICE_TOKEN_PREVIOUS=
INTERNAL_HEALTH_TOKEN=dev-health-token
TRUSTED_PROXY_IPS=
TRUSTED_BFF_IPS=
TRUSTED_HOSTS=
READINESS_CACHE_STORE=redis
TENANT_RESOLUTION_CACHE_STORE=redis
TENANT_PUBLIC_CONTENT_CACHE_STORE=redis
PUBLIC_IDEMPOTENCY_CACHE_STORE=redis
TENANT_PUBLIC_MEDIA_BASE_URL=/api/public
TENANT_RESOLUTION_CACHE_TTL=300
TENANT_PUBLIC_CONTENT_CACHE_TTL=300
TENANT_PUBLIC_CACHE_MAX_AGE=60
TENANT_PUBLIC_CACHE_SHARED_MAX_AGE=300
TENANT_PUBLIC_CACHE_STALE_WHILE_REVALIDATE=60
QUOTE_TTL_MINUTES=15
PAYMENT_TTL_MINUTES=30
STOCK_HOLD_TTL_MINUTES=20
IDEMPOTENCY_TTL_HOURS=24
TENANT_EXPIRED_SUBSCRIPTION_PUBLIC_READ=false
TENANT_GRACE_PERIOD_PUBLIC_READ=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/central/auth/google/callback
GOOGLE_AUTH_FRONTEND_CALLBACK_URL=http://localhost:3005/auth/google/callback
GOOGLE_AUTH_EXCHANGE_TTL=60

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3005
CORS_ALLOWED_ORIGINS_PATTERNS=/^http:\/\/([a-z0-9-]+\.)?sewantara\.test(:[0-9]+)?$/
CORS_SUPPORTS_CREDENTIALS=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sewantara.test"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

REGISTRATION_OTP_TTL_MINUTES=5
REGISTRATION_OTP_RESEND_SECONDS=60
REGISTRATION_OTP_MAX_ATTEMPTS=5
REGISTRATION_OTP_VERIFIED_TTL_MINUTES=30

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_3DS=true
XENDIT_PUBLIC_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_NOTIFICATION_URL=http://localhost:8090/api/central/billing/doku/webhook
PAYMENT_GATEWAY=midtrans
SUBSCRIPTION_PAYMENT_GATEWAY=xendit
SUBSCRIPTION_PAYMENT_SUCCESS_URL=http://localhost:3005
SUBSCRIPTION_PAYMENT_CANCEL_URL=http://localhost:3005

LARAVEL_CACHE_CONFIG=false
