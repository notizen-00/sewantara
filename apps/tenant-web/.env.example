APP_PORT=3000
CONTAINER_PORT=3000
IMAGE_TAG=local

NUXT_PUBLIC_APP_NAME=Sewantara
NUXT_PUBLIC_BASE_URL=https://sewantara.id
NUXT_PUBLIC_BASE_DOMAIN=sewantara.id
NUXT_PUBLIC_CDN=

# Browser hanya berkomunikasi dengan BFF same-origin di /api.
NUXT_API_BASE=https://api.sewantara.id
NUXT_API_TOKEN=

# Adapter endpoint Laravel. Ubah di environment tanpa menyentuh UI.
NUXT_API_TENANT_ENDPOINT=/v1/public/tenant
NUXT_API_HOME_ENDPOINT=/v1/public/home
NUXT_API_CATALOG_ENDPOINT=/v1/public/catalog
NUXT_API_QUOTE_ENDPOINT=/v1/public/bookings/quote
NUXT_API_BOOKINGS_ENDPOINT=/v1/public/bookings
NUXT_API_TRACKING_ENDPOINT=/v1/public/bookings
NUXT_API_BLOG_ENDPOINT=/v1/public/blog

# Demo aktif secara default agar project bisa dijalankan tanpa backend.
# Set false setelah kontrak API Laravel tersedia.
NUXT_PUBLIC_DEMO_MODE=true
NUXT_PUBLIC_DEMO_TENANT=kamerajember

# Aktifkan hanya jika Nitro berada di belakang reverse proxy terpercaya yang
# selalu menimpa forwarded headers. Custom domain bersifat opt-in.
NUXT_TRUST_PROXY=false
NUXT_ALLOW_CUSTOM_DOMAINS=false
NUXT_ROOT_TENANT=
